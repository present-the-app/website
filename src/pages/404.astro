---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
import { strings } from "../i18n";
import type { Locale } from "../config/site";

/**
 * Both languages: a 404 can be reached from either language tree, and the URL
 * that produced it tells us nothing reliable about which one the reader wanted.
 */
const HOME: Record<Locale, string> = { en: "/", fr: "/fr/" };
const blocks = site.locales.map((l) => ({ locale: l, s: strings[l], home: HOME[l] }));
const first = blocks[0];
---

<Base title={strings.en.notFound.title} noindex>
  <div class="u-wrap page">
    <h1 class="u-display h1">{first.s.notFound.title}</h1>
    <p class="body">{first.s.notFound.body}</p>
    <a class="u-btn" href={first.home}>{first.s.notFound.home}</a>

    <div class="alts">
      {
        blocks.slice(1).map((b) => (
          <div class="alt" lang={b.locale}>
            <p class="body body--sm">{b.s.notFound.body}</p>
            <a class="u-link" href={b.home}>
              {b.s.notFound.home}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: 100px 120px;
    max-width: 660px;
  }
  .h1 {
    font-size: clamp(34px, 5vw, 56px);
    margin: 0 0 18px;
  }
  .body {
    font-size: 18px;
    color: var(--color-muted);
    margin: 0 0 28px;
  }
  .body--sm {
    font-size: 16px;
    margin-bottom: 10px;
  }
  .alts {
    margin-top: 52px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: 28px;
  }
</style>
