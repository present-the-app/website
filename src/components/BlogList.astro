---
import { getCollection } from "astro:content";
import { t, localeFromPath } from "../i18n";
import type { Locale } from "../config/site";

const locale = localeFromPath(Astro.url.pathname) as Locale;
const s = t(locale);

const BASE: Record<Locale, string> = {
  en: "/writing",
  fr: "/fr/journal",
};
const base = BASE[locale];

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === locale && !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const INTL: Record<Locale, string> = {
  en: "en-GB",
  fr: "fr-CH",
};

const df = new Intl.DateTimeFormat(INTL[locale], {
  day: "numeric",
  month: "long",
  year: "numeric",
});

/** Entry ids come out as "en/slug" because the loader base is the blog dir. */
const slugOf = (id: string) => id.split("/").pop()!;
---

<div class="u-wrap page">
  <h1 class="u-display h1">{s.blog.title}</h1>
  <p class="intro">{s.blog.intro}</p>

  {
    posts.length === 0 ? (
      <p class="empty">{s.blog.empty}</p>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <li class="item">
            <p class="item__date">
              <time datetime={p.data.pubDate.toISOString()}>
                {df.format(p.data.pubDate)}
              </time>
            </p>
            <h2 class="item__t">
              <a href={`${base}/${slugOf(p.id)}/`}>{p.data.title}</a>
            </h2>
            <p class="item__d">{p.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .page {
    padding-block: 84px 100px;
    max-width: 760px;
  }
  .h1 {
    font-size: clamp(34px, 5vw, 56px);
    margin: 0 0 16px;
  }
  .intro {
    font-size: 18px;
    color: var(--color-muted);
    margin: 0 0 48px;
    max-width: 54ch;
  }
  .empty {
    color: var(--color-faint);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .item {
    padding: 26px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .item__date {
    font-size: 13px;
    color: var(--color-faint);
    margin: 0 0 8px;
    letter-spacing: 0.03em;
  }
  .item__t {
    font-family: var(--font-display);
    font-variation-settings: "wght" 600;
    font-size: clamp(21px, 2.4vw, 27px);
    letter-spacing: -0.02em;
    line-height: 1.16;
    margin: 0 0 10px;
  }
  .item__t a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .item__t a:hover {
    color: var(--color-pine);
  }
  .item__d {
    color: var(--color-muted);
    font-size: 16px;
    margin: 0;
    max-width: 62ch;
  }
</style>
