---
import { t, localeFromPath } from "../../i18n";
import Section from "../Section.astro";

const s = t(localeFromPath(Astro.url.pathname));
---

<Section id="how" eyebrow={s.how.eyebrow} title={s.how.title}>
  {/* Numbered because this genuinely is a sequence: the order carries meaning. */}
  <ol class="steps">
    {
      s.how.steps.map((step, i) => (
        <li class="step">
          <span class="step__n">{i + 1}</span>
          <h3 class="step__t">{step.title}</h3>
          <p class="step__b">{step.body}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    list-style: none;
    counter-reset: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 34px;
  }
  .step {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }
  .step__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    border-radius: 999px;
    background: var(--color-pine-soft);
    color: var(--color-pine-ink);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .step__t {
    font-size: 17.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }
  .step__b {
    font-size: 15.5px;
    color: var(--color-muted);
    margin: 0;
  }
</style>
