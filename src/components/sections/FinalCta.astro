---
import { t, localeFromPath, localePath } from "../../i18n";
import WaitlistForm from "../WaitlistForm.astro";

const locale = localeFromPath(Astro.url.pathname);
const s = t(locale);
---

<section class="cta">
  <div class="u-wrap cta__in">
    <h2 class="u-display cta__t">{s.finalCta.title}</h2>
    <p class="cta__b">{s.finalCta.body}</p>
    <div class="cta__form">
      <WaitlistForm id="cta-email" />
    </div>
  </div>

  <div class="u-wrap">
    <ul class="trust">
      {s.trust.items.map((item) => <li>{item}</li>)}
      <li>
        <a href={localePath(locale, "/privacy/")}>{s.trust.link}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .cta {
    padding-block: 108px 72px;
  }
  .cta__in {
    text-align: center;
  }
  .cta__t {
    font-size: clamp(34px, 5.4vw, 68px);
    margin: 0;
    max-width: 15ch;
    margin-inline: auto;
  }
  .cta__b {
    color: var(--color-muted);
    font-size: 18px;
    margin: 18px auto 30px;
  }
  .cta__form {
    display: flex;
    justify-content: center;
  }
  .cta__form :global(.wl) {
    width: 100%;
    max-width: 480px;
  }
  .cta__form :global(.wl__micro) {
    text-align: center;
    margin-inline: auto;
  }

  .trust {
    list-style: none;
    margin: 72px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    justify-content: center;
    font-size: 14px;
    color: var(--color-faint);
  }
  .trust a {
    color: var(--color-muted);
    text-underline-offset: 3px;
  }
  .trust a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 700px) {
    .cta {
      padding-block: 68px 56px;
    }
    .trust {
      margin-top: 48px;
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
