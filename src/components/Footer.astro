---
import { site } from "../config/site";
import type { Locale } from "../config/site";
import { t, localeFromPath, localePath, otherLocales, strings } from "../i18n";
import Wordmark from "./Wordmark.astro";

interface Props {
  alts: Record<Locale, string>;
}
const { alts } = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const s = t(locale);
const year = new Date().getFullYear();

// Each language is named in its own language, which is the one label a reader
// who cannot read the current page is guaranteed to recognise.
const switchers = otherLocales(locale)
  .map((l) => ({ locale: l, href: alts[l], label: strings[l].meta.localeName }))
  .filter((x) => x.href !== Astro.url.pathname);
---

<footer class="ft">
  <div class="u-wrap ft__in">
    <div class="ft__brand">
      <span class="ft__mark"><Wordmark size={20} /> {site.name}</span>
      <p class="ft__tagline">{s.footer.tagline}</p>
    </div>

    <nav class="ft__links" aria-label="Footer">
      <a href={localePath(locale, "/privacy/")}>{s.footer.privacy}</a>
      <a href={localePath(locale, "/writing/")}>{s.footer.blog}</a>
      <a href={localePath(locale, "/contact/")}>{s.footer.contact}</a>
      {
        switchers.map((x) => (
          <a href={x.href} hreflang={x.locale} lang={x.locale}>
            {x.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="u-wrap ft__base">
    <p class="ft__note">&copy; {year} &middot; {s.footer.rights}</p>
  </div>
</footer>

<style>
  .ft {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: 54px 40px;
  }
  .ft__in {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
  }
  .ft__mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-variation-settings: "wght" 700;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .ft__tagline {
    color: var(--color-muted);
    font-size: 15px;
    margin: 10px 0 0;
    max-width: 38ch;
  }
  .ft__links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    font-size: 15px;
  }
  .ft__links a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .ft__links a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ft__base {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .ft__note {
    font-size: 13px;
    color: var(--color-faint);
    margin: 0;
    max-width: 62ch;
  }
</style>
