---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  /** Alternate surface, used to separate adjacent sections without a rule. */
  tone?: "paper" | "surface";
  /** Wide titles for statement sections, narrow for ordinary ones. */
  statement?: boolean;
}
const { id, eyebrow, title, tone = "paper", statement = false } = Astro.props;
---

<section id={id} class:list={["sec", `sec--${tone}`]}>
  <div class="u-wrap">
    {eyebrow && <p class="u-eyebrow sec__eyebrow">{eyebrow}</p>}
    {
      title && (
        <h2 class:list={["u-display", "sec__title", statement && "sec__title--statement"]}>
          {title}
        </h2>
      )
    }
    <slot />
  </div>
</section>

<style>
  /* One place decides section rhythm. Adjacent tones differ, so no rules are
     needed to separate them. */
  .sec {
    padding-block: 104px;
  }
  .sec--surface {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }
  .sec__eyebrow {
    color: var(--color-pine);
    margin: 0 0 16px;
  }
  .sec__title {
    font-size: clamp(30px, 4vw, 50px);
    margin: 0;
    max-width: 20ch;
  }
  .sec__title--statement {
    font-size: clamp(32px, 5vw, 66px);
    max-width: 17ch;
  }

  @media (max-width: 700px) {
    .sec {
      padding-block: 64px;
    }
  }
</style>
